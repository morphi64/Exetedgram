name: Build Exetedgram APK

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: android-actions/setup-android@v3

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build APK
        run: |
          unzip -q Exetedgram_Cloud_Build_Project.zip
          cd ExetedgramAndroid
          gradle assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: Exetedgram-APK
          path: ExetedgramAndroid/app/build/outputs/apk/debug/app-debug.apk
